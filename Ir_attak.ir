cat << 'EOF' > lg_remote.py
import os
import sys

# Raw ИК-коды для телевизоров LG (Частота 38кГц, протокол NEC)
COMMANDS = {
    "1": {
        "name": "Включить / Выключить (Power)",
        "pattern": "9000 4500 560 560 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 1690 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560 1690 560 560 560 560 560 560 560 1690 560 560 560 560 560 560 560 560 560 1690 560 1690 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560"
    },
    "2": {
        "name": "Громкость + (Vol Up)",
        "pattern": "9000 4500 560 560 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 1690 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560 560 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 560 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560 1690 560 1690 560"
    },
    "3": {
        "name": "Громкость - (Vol Down)",
        "pattern": "9000 4500 560 560 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 1690 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560 1690 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 560 560 560 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560 1690 560"
    },
    "4": {
        "name": "Без звука (Mute)",
        "pattern": "9000 4500 560 560 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 1690 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560 560 560 1690 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 1690 560 560 560 1690 560 1690 560 560 560 1690 560 1690 560 1690 560"
    },
    "5": {
        "name": "Смена входа (HDMI / Source)",
        "pattern": "9000 4500 560 560 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 1690 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560 1690 560 1690 560 560 560 1690 560 560 560 560 560 560 560 560 560 560 560 560 560 560 560 1690 560 560 560 1690 560 1690 560 1690 560 1690 560"
    }
}

def send_ir(pattern):
    frequency = 38000
    arg_array = " ".join([f"i32 {num}" for num in pattern.split()])
    cmd = f"adb shell service call consumer_ir 1 i32 {frequency} {arg_array} > /dev/null"
    os.system(cmd)

def check_connection():
    # Проверка, подключен ли ADB к локальному порту
    result = os.popen("adb devices").read()
    if "127.0.0.1" in result and "device" in result:
        return True
    return False

def main():
    print("\033[92m=== ХАКЕРСКИЙ ИК-ПУЛЬТ LG ДЛЯ TECNO POVA 7 ===\033[0m")
    
    if not check_connection():
        print("\033[91m[!] Ошибка: ADB не подключен к локальному хосту.\033[0m")
        port = input("[?] Введите текущий 5-значный порт отладки по Wi-Fi: ").strip()
        if port:
            print(f"[*] Попытка подключения к 127.0.0.1:{port}...")
            os.system(f"adb connect 127.0.0.1:{port}")
            if not check_connection():
                print("\033[91m[-] Не удалось подключиться. Проверьте тумблер отладки!\033[0m")
                sys.exit(1)
        else:
            sys.exit(1)

    while True:
        print("\nДоступные команды:")
        for key, info in COMMANDS.items():
            print(f" [{key}] {info['name']}")
        print(" [0] Выход из скрипта")
        
        choice = input("\nВыберите действие: ").strip()
        
        if choice == "0":
            print("Выход...")
            break
        elif choice in COMMANDS:
            print(f"[*] Отправка сигнала: {COMMANDS[choice]['name']}...")
            send_ir(COMMANDS[choice]["pattern"])
            print("[+] Сигнал успешно выстрелен!")
        else:
            print("\033[91mНеверный ввод, попробуйте еще раз.\033[0m")

if __name__ == "__main__":
    main()
EOF
